generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Period {
  DAY
  WEEK
  MONTH
}
model JournalEntry {
  id        String   @id @default(cuid())
  period    Period   @default(DAY)
  date      DateTime @db.Date
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  links     ResourceLink[]
  @@index([date, period])
}
model ResourceLink {
  id         String @id @default(cuid())
  journalId  String
  source     String
  externalId String
  url        String
  label      String
  journal    JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  @@unique([journalId, source, externalId])
}

model ResearchExperiment {
  id          String   @id @default(cuid())
  title       String
  description String   @default("") @db.Text
  sourceType  String
  repository  String?
  sourcePath  String
  sourceRef   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  runs        ExperimentRun[]
  launches    PalmaLaunch[]
  @@index([createdAt])
}

model LiteraturePaper {
  id        String   @id @default(cuid())
  paper     String   @db.Text
  authors   String   @default("") @db.Text
  year      String   @default("")
  journal   String   @default("") @db.Text
  imageType String   @default("") @db.Text
  notes     String   @default("") @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt])
}

model ResearchDataset {
  id          String @id
  title       String
  description String @default("") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  variants    DatasetVariant[]
}

model DatasetVariant {
  id        String @id @default(cuid())
  datasetId String
  variantId String
  metadata  Json
  createdAt DateTime @default(now())
  dataset   ResearchDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  runs      ExperimentRun[]
  @@unique([datasetId, variantId])
}

model ExperimentRun {
  id               String @id @default(cuid())
  experimentId     String
  datasetVariantId String
  runKey           String
  manifest         Json
  importedAt       DateTime @default(now())
  experiment       ResearchExperiment @relation(fields: [experimentId], references: [id], onDelete: Restrict)
  datasetVariant   DatasetVariant @relation(fields: [datasetVariantId], references: [id], onDelete: Restrict)
  files            RunFile[]
  @@unique([experimentId, runKey])
}

model RunFile {
  runId   String
  path    String
  content Bytes?
  digest  String?
  size    Int?
  run     ExperimentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@id([runId, path])
}

model PalmaLaunch {
  id           String @id
  experimentId String
  ratio        Int
  ratios       Int[] @default([])
  pipelineCommit String @default("")
  backend      String @default("legacy")
  datasetId    String @default("sample_0001")
  method       String @default("mct")
  projectionIndex Int @default(0)
  slices       Int[] @default([0])
  variantId    String @default("quick_4rows")
  datasetSha   String
  status       String
  githubRunId  String?
  message      String @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  experiment   ResearchExperiment @relation(fields: [experimentId], references: [id], onDelete: Restrict)
  @@index([experimentId, createdAt])
}
